# Pets24x7 API — copy to .env and fill in.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public URLs (used in CORS, redirects, OG embeds)
PUBLIC_SITE_URL=https://pets24x7.com
# Base URL used for links and branding inside outbound email. Optional —
# defaults to PUBLIC_SITE_URL. Set it on a dev box so mail never carries
# localhost links.
MAIL_SITE_URL=https://pets24x7.com
PUBLIC_API_URL=https://api.pets24x7.com

# ---- Postgres (Supabase) ----
# Get from Supabase project > Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres?schema=public"

# ---- Auth ----
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-96-random-hex-chars"
JWT_ISSUER="pets24x7.com"
COOKIE_DOMAIN=".pets24x7.com"
ADMIN_SESSION_SECRET="another-96-random-hex-chars"

# ---- WhatsApp Cloud API (Meta) ----
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WA_PHONE_NUMBER_ID="123456789012345"
WA_BUSINESS_ACCOUNT_ID="123456789012345"
WA_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxx"
WA_VERIFY_TOKEN="any-random-string-you-pick"
WA_OTP_TEMPLATE_NAME="pets24x7_otp"
WA_OTP_TEMPLATE_LANG="en"
# Phase 3.1 — vendor review-request template (must be approved separately in WA Manager)
WA_REVIEW_TEMPLATE_NAME="pets24x7_review_request"
WA_REVIEW_TEMPLATE_LANG="en"
# Public short-link domain — used in the WA message body. Frontend serves /r/:code.
PUBLIC_SHORTLINK_BASE="https://pets24x7.com"

# ---- Static-site data (frontend repo) ----
# Path to the frontend's data/ folder for phone-match listing lookup.
# Defaults to ../pets24x7_new/data when running locally.
STATIC_DATA_DIR="../pets24x7_new/data"

# ---- Razorpay Payment Gateway ----
# Keys: https://dashboard.razorpay.com → Settings → API Keys
# Test keys start with rzp_test_, live keys with rzp_live_.
# Leave both blank in development to use the local no-charge bypass.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same secret on the webhook at
# https://dashboard.razorpay.com → Settings → Webhooks
#   URL:    https://api.pets24x7.com/api/payments/razorpay/webhook
#   Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# ---- Invoices ----
# Your GSTIN (15 chars). When set, /api/memberships/invoice/:txn renders a GST
# "Tax invoice" with the tax split out; blank renders a plain invoice.
SELLER_GSTIN=""
# GST_RATE_PERCENT=18

# ---- Bootstrap admin (used by `npm run seed:admin`) ----
# Inbox for admin-facing alerts raised by public requests (a new vendor
# signing up). Falls back to the OWNER admins on record, then SEED_ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL="founder@pets24x7.com"
SEED_ADMIN_EMAIL="founder@pets24x7.com"
SEED_ADMIN_PASSWORD="change-me-strong-password"
SEED_ADMIN_NAME="Pets24x7 Founder"

# ---- Email ----
# Two supported relays. Fill in ONE set; leave SMTP_USER / SMTP_PASS empty to
# keep sending as a logged no-op (see src/mail/mailer.ts).
#
# Production — Resend, with pets24x7.com verified and DKIM-signed.
# SMTP_USER is the literal string "resend"; SMTP_PASS is the Resend API key.
#   SMTP_HOST=smtp.resend.com
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM="Pets24x7 <noreply@pets24x7.com>"
#
# Local dev / demo — Gmail SMTP with a 16-char app password.
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Gmail caps near 500 messages a day and cannot DKIM-sign your own domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pets24x7.noreply@gmail.com
SMTP_PASS=
MAIL_FROM="Pets24x7 <pets24x7.noreply@gmail.com>"
# Outside production, mail is logged instead of sent. Set to true only when you
# deliberately want a dev run to deliver to real inboxes.
MAIL_ALLOW_DEV_SEND=false
EMAIL_VERIFY_TTL_MIN=10

# ---- Google Sign-In ----
# OAuth 2.0 Web client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ---- Scaling (all optional; a single server needs none of these) ----
# See DEPLOY.md "Scaling to multiple servers". Without REDIS_URL, rate limits
# and the cache stay in process memory, exactly as on one server.
# REDIS_URL=redis://:password@10.0.0.5:6379/0
# REDIS_KEY_PREFIX=p24x7:
# KV_MEMORY_MAX_ENTRIES=10000
# RUN_JOBS=true

# ---- Site publish (admin "Publish site" button; all optional) ----
# See DEPLOY.md section 10, "Managing listings". With neither the trigger file
# nor the command set, POST /api/admin/publish answers 501 and only the nightly
# publish timer runs.
# PUBLISH_TRIGGER_FILE=/opt/pets24x7/run/publish.request
# PUBLISH_COMMAND=
# PUBLISH_STATUS_FILE=/var/lib/pets24x7/publish-status.json

# Pets24x7 — Netlify cache headers.
# Static assets get long cache; HTML stays fresh so content edits ship fast.

# Security headers on every response. Pretty URLs (/in/mumbai/) never match
# /*.html, so on that rule alone almost no page got them.
/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/*.html
  Cache-Control: public, max-age=300, s-maxage=600

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/config.js
  Cache-Control: public, max-age=300

/pets-data.js
  Cache-Control: public, max-age=1800

/pets-loader.js
  Cache-Control: public, max-age=86400

/pets24x7_logo.png
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=1800

/sitemap.xml
  Cache-Control: public, max-age=3600

# The sitemap index points at these children (sitemap-in-1.xml, sitemap-us-1.xml, ...).
/sitemap-*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

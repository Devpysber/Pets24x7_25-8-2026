# Pets24x7 — Netlify (and Cloudflare Pages) redirect rules.
# Format: <from>  <to>  <status>

# 301 legacy query-string URLs to clean URLs (server-side, before JS runs).
# Netlify supports query-param matching via the splat + query syntax. The
# 3-param (country+city+cat) rule must come before the 2-param one — Netlify
# matches rules in file order and a &cat= link must not fall through to the
# city-only rule and lose its category segment.
/city.html       /:country/:city/:cat/     301  country=:country  city=:city  cat=:cat
/city.html       /:country/:city/          301  country=:country  city=:city
/listing.html    /:country/:city/:id/      301  country=:country  city=:city  id=:id

# Trailing slashes: NOT done here. Netlify normalises the trailing slash before
# matching, so "/in/:city  /in/:city/  301!" matches its own target and loops
# (ERR_TOO_MANY_REDIRECTS on every city page). Pretty URLs in netlify.toml
# already serve /in/mumbai/ from /in/mumbai/index.html.

# Phase 3.1 — Review short-link routing (mirrors .htaccess; Apache hosts use that).
# /review/<CODE>/ and its /form/ + /thanks/ steps are one static page each,
# with the code handed over as a query param.
/review/:code/          /review/index.html?code=:code         200
/review/:code/form      /review/form/index.html?code=:code    200
/review/:code/thanks    /review/thanks/index.html?code=:code  200

# Review short-link hop — /r/ is served by the API, not this static site.
/r/:code   https://api.pets24x7.com/r/:code   302

# Listings and cities added after the last static build have no pre-built
# folder. These rewrites (200, so the clean URL is kept) hand the request to the
# generic pages, which resolve the record from the API instead of 404ing.
# A city+category URL has the same shape as a listing URL (/in/<city>/<x>/),
# so the known category slugs are routed to the city page first; everything
# else in that position is a listing id.
/in/:city/veterinary-clinics/   /city.html   200
/us/:city/veterinary-clinics/   /city.html   200

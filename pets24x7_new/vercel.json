{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pets24x7_logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/pets-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/city.html",
      "destination": "/in/:city/:cat/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Ii][Nn]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        },
        {
          "type": "query",
          "key": "cat",
          "value": "(?<cat>[a-z0-9-]+)"
        }
      ]
    },
    {
      "source": "/city.html",
      "destination": "/us/:city/:cat/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Uu][Ss]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        },
        {
          "type": "query",
          "key": "cat",
          "value": "(?<cat>[a-z0-9-]+)"
        }
      ]
    },
    {
      "source": "/city.html",
      "destination": "/in/:city/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Ii][Nn]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        }
      ]
    },
    {
      "source": "/city.html",
      "destination": "/us/:city/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Uu][Ss]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        }
      ]
    },
    {
      "source": "/listing.html",
      "destination": "/in/:city/:id/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Ii][Nn]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        },
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[^&]+)"
        }
      ]
    },
    {
      "source": "/listing.html",
      "destination": "/us/:city/:id/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "country",
          "value": "[Uu][Ss]"
        },
        {
          "type": "query",
          "key": "city",
          "value": "(?<city>[a-z0-9-]+)"
        },
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[^&]+)"
        }
      ]
    },
    {
      "source": "/listing.html",
      "destination": "/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ]
    },
    {
      "source": "/r/:code",
      "destination": "https://api.pets24x7.com/r/:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/review/:code/",
      "destination": "/review/index.html?code=:code"
    },
    {
      "source": "/review/:code/form/",
      "destination": "/review/form/index.html?code=:code"
    },
    {
      "source": "/review/:code/thanks/",
      "destination": "/review/thanks/index.html?code=:code"
    },
    {
      "source": "/:country(in|us)/:city/(veterinary-clinics|emergency-animal-hospital|vaccination-centers|mobile-vet-services|specialty-vets-exotics-avian-reptiles|veterinary-labs-diagnostics|pet-dental-care|pet-physiotherapy-rehab|pet-grooming-spa|pet-boarding-daycare|pet-walking|pet-training-obedience-behavior|pet-sitting-in-home-care|pet-relocation-services|pet-taxi-transport|pet-therapy-services)/",
      "destination": "/city.html"
    },
    {
      "source": "/:country(in|us)/:city/page/:n([0-9]+)/",
      "destination": "/city.html"
    },
    {
      "source": "/:country(in|us)/:city/:id/",
      "destination": "/listing.html"
    },
    {
      "source": "/:country(in|us)/:city/",
      "destination": "/city.html"
    }
  ]
}
